      t: "`$OBJECT`"
    }
    lastName: {
      h: "Last Name"
      n: "lastName"
      r: false
      sh: "The last name of the visitor that you wish to identify."
      t: "`$STRING`"
    }
    token: {
      h: "Token"
      n: "token"
      r: true
      sh: "An identification token that allows the visitor to be treated as a known contact."
      t: "`$STRING`"
    }
  }

  name: "visitor_identification_identification_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
