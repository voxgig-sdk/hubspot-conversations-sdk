# Entity: visitor_identification_identification_token

main: kit: entity: visitor_identification_identification_token: {

  alias: field: {}

  fields: {
    email: {
      h: "Email"
      n: "email"
      r: true
      sh: "The email of the visitor that you wish to identify"
      t: "`$STRING`"
    }
    firstName: {
      h: "First Name"
      n: "firstName"
      r: false
