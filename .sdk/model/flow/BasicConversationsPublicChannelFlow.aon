# BasicConversationsPublicChannelFlow

main: kit: flow: BasicConversationsPublicChannelFlow:
{
  entity: "conversations_public_channel",
  kind: "basic",
  name: "BasicConversationsPublicChannelFlow",
  step: [
    {
      input: {
        ref: "conversations_public_channel_ref01",
        srcdatavar: "conversations_public_channel_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "conversations_public_channel01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-conversations_public_channel_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicConversationsPublicChannelFlow"
}